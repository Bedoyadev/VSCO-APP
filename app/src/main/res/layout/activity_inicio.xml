<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".MainActivity"
    android:id="@+id/main"
    android:background="@color/fondo">

    <ImageButton
        android:id="@+id/menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:backgroundTint="@color/fondo"
        android:visibility="visible"
        android:contentDescription="@string/menu"
        android:src="@drawable/menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints,DuplicateSpeakableTextCheck" />
    <TextView
        android:id="@+id/Nom_usuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/menu"
        android:text="Bienvenido, Usuario!"
        android:visibility="visible"
        app:layout_constraintEnd_toStartOf="@id/salir"
        android:textColor="@color/fuente_logo"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="15dp"
        android:layout_gravity="center"
        tools:ignore="HardcodedText" />

    <ImageButton
        android:id="@+id/salir"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="270dp"
        android:layout_marginTop="9dp"
        android:visibility="visible"
        android:backgroundTint="@color/fondo"
        android:contentDescription="@string/menu"
        android:src="@drawable/salida1"
        app:layout_constraintStart_toEndOf="@id/menu"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints,TouchTargetSizeCheck,ImageContrastCheck" />
    <androidx.recyclerview.widget.RecyclerView

        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="638dp"
        app:layout_constraintTop_toBottomOf="@id/salir"
        android:layout_marginTop="15dp">

    </androidx.recyclerview.widget.RecyclerView>



    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/boton_agregar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="300dp"
        android:visibility="visible"
        android:layout_marginTop="600dp"
        android:backgroundTint="@color/fuente_logo"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/agregar"
        app:tint = "@android:color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.513"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:visibility="visible"
        android:layout_height="match_parent"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/linea_menu"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="visible"
        android:layout_marginTop="50dp"
        android:contentDescription="@string/linea_menu"
        android:background="@color/fuente_logo"
        app:layout_constraintTop_toBottomOf="@id/boton_agregar"
        />

    <Button
        android:id="@+id/noticias"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:visibility="visible"
        android:backgroundTint="@color/fondo"
        android:contentDescription="@string/noticias"
        android:drawableTop="@drawable/casita"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linea_menu"
        tools:ignore="MissingConstraints,TouchTargetSizeCheck,DuplicateSpeakableTextCheck"

        />

    <Button
        android:id="@+id/buscar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:visibility="visible"
        android:drawableTop="@drawable/lupita"
        android:contentDescription="@string/buscar"
        app:layout_constraintTop_toBottomOf="@id/linea_menu"
        android:backgroundTint="@color/fondo"
        app:layout_constraintStart_toEndOf="@id/noticias"
        android:layout_marginStart="20dp"
        />
    <Button
        android:id="@+id/cuadro_studio"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:visibility="visible"
        android:drawableTop="@drawable/editar"
        app:layout_constraintTop_toBottomOf="@id/linea_menu"
        android:backgroundTint="@color/fondo"
        android:contentDescription="@string/cuadro"
        app:layout_constraintStart_toEndOf="@id/buscar"
        android:layout_marginStart="20dp"
        />
    <TextView
        android:id="@+id/texto_noticias"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/cuadro_studio"
        android:text="@string/estudio"
        android:layout_marginTop="4dp"
        android:visibility="visible"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/cuadro_studio"
        android:layout_marginStart="9dp"
        android:textColor="@color/fuente_logo"
        tools:ignore="MissingConstraints"/>

    <Button
        android:id="@+id/perfil"
        android:layout_width="60dp"
        android:visibility="visible"
        android:layout_height="60dp"
        android:contentDescription="@string/perfil1"
        android:drawableTop="@drawable/perfil"
        app:layout_constraintTop_toBottomOf="@id/linea_menu"
        android:backgroundTint="@color/fondo"
        app:layout_constraintStart_toEndOf="@id/cuadro_studio"
        android:layout_marginStart="20dp"
        />

    <Button
        android:id="@+id/spaces"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:visibility="visible"
        android:drawableTop="@drawable/spaces"
        app:layout_constraintTop_toBottomOf="@id/linea_menu"
        android:backgroundTint="@color/fondo"
        android:contentDescription="@string/spaces1"
        app:layout_constraintStart_toEndOf="@id/perfil"
        android:layout_marginStart="20dp"
        />
</androidx.constraintlayout.widget.ConstraintLayout>













