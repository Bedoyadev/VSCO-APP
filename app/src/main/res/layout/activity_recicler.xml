<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fragment"
    android:backgroundTint="@null"
    android:layout_marginBottom="10dp"
    >
    <ImageView
    android:id="@+id/imagen_publicacion"
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:contentDescription="@string/foto_publicacion"
    android:scaleType="centerCrop"
    android:layout_marginTop="10dp"
    android:layout_marginStart="8dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    tools:src="@tools:sample/avatars" />
    <TextView
    android:id="@+id/titulo_publicacion"
    android:layout_width="0dp"
    android:layout_height="50dp"
    android:gravity="center"
    android:layout_marginStart="8dp"
    android:fontFamily="@font/inputs_fuente"
    android:layout_marginEnd="8dp"
    android:textSize="14sp"
    android:textColor="@color/fuente_logo"
    app:layout_constraintTop_toTopOf="@id/imagen_publicacion"
    app:layout_constraintStart_toEndOf="@id/imagen_publicacion"
    app:layout_constraintEnd_toEndOf="parent"
    tools:text="Título de la Publicación" />
    <TextView
    android:id="@+id/descripcion_publicacion"
    android:layout_width="0dp"
    android:fontFamily="@font/inputs_fuente"
    android:layout_height="100dp"
    android:textSize="10sp"
    android:layout_marginTop="10dp"
    android:gravity="center"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:textColor="@color/fuente_logo"
    app:layout_constraintTop_toBottomOf="@id/titulo_publicacion"
    app:layout_constraintStart_toEndOf="@id/imagen_publicacion"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintBottom_toBottomOf="@id/imagen_publicacion" tools:text="Esta es una descripción más larga de la publicación que podría ocupar varias líneas de texto."
        tools:ignore="SmallSp" />
</androidx.constraintlayout.widget.ConstraintLayout>